# Role (§14): api | gateway | worker | all (dev default)
ROLE=all
# GATEWAY_ID=gw-1
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://pipod:pipod@localhost:5432/pipod
# Every role binds HOST:PORT. /healthz and /metrics are unauthenticated by default so a
# private Prometheus can scrape them; do not expose that port publicly. Set METRICS_TOKEN
# (min 16 characters) to require Authorization: Bearer <token> on /metrics. Never log it.
# Cluster inventory (pod/job/queue depths) is emitted only by ROLE=worker or ROLE=all.
# METRICS_TOKEN=

# Zitadel resource-server settings. No management API credentials belong here.
ZITADEL_ISSUER=http://127.0.0.1:8081
# Production: the Zitadel project id of the `pipod` project.
ZITADEL_API_AUDIENCE=pipod-api
# The `pipod-cli` app's client id, published to `pipod login` at GET /v1/auth/config.
# ZITADEL_CLI_CLIENT_ID=
# ZITADEL_JWKS_URL=http://127.0.0.1:9999/jwks   # local signer for make / tests
# ZITADEL_ACCOUNT_URL=http://127.0.0.1:8081/ui/console/users/me
# ZITADEL_ADMIN_URL=http://127.0.0.1:8081/ui/console

# Envelope-encryption KEK for secrets (§7): base64 of 32 random bytes
#   openssl rand -base64 32
# Keep this file 0600 and root-owned.
# The server refuses to start if the key is not exactly 32 bytes, and never logs it.
SECRETS_KEK=
SECRETS_KEK_ID=kek-1
# Rotation: move the current key/id into SECRETS_KEK_PREVIOUS, set the new pair above,
# restart. Stored secrets record the id that wrapped them, so old rows stay readable and
# each write re-wraps under the new id — no bulk re-encryption. Drop a retired version only
# once no key_id in secrets, pi_auth, pi_settings, pod_launch_env, or model_credentials
# still names it.
# SECRETS_KEK_PREVIOUS={"kek-1":"<base64 32 bytes>"}

# Platform-owned provider accounts (per-org BYO keys live in org secrets instead, §7)
# SANDBOX_HOST_BACKEND=static
# Boat host backend is reserved and not implemented yet. Selecting boat requires:
# BOAT_API_KEY=
# BOAT_TEMPLATE=
# BOAT_WEBHOOK_SECRET=
# BOAT_ORG_ID=team_<explicit-organization-wallet>
# BOAT_RUNTIME_SHA256=<independently-trusted-64-hex-artifact-digest>
# BOAT_SIZE=default
# BOAT_TTL_SECONDS=7200
# BOAT_OPERATION_DEADLINE_SECONDS=1200
# BOAT_POLL_SECONDS=10
# BOAT_LEASE_SECONDS=120
# BOAT_OPERATIONS_PER_TICK=4
# BOAT_STOP_ALL=false
# Controller APIs are async. Placement/automatic wake integration and live
# qualification are separate rollout gates: do not enable production Boat yet.
# PI_POD_SANDBOX_TOKEN=
# Deployment-owned service URL; users do not put this in account-mode config.
# PI_POD_SANDBOX_URL=http://pi-pod-sandbox:8433
# OCI namespace used for canonical pi-pod-base tags; production preloads its private package.
# PI_POD_SANDBOX_IMAGE_MIRROR=ghcr.io/pi-pod
# IMAGE_PREWARM_ENABLED=true

# PUBLIC_URL=https://api.pipod.example
# Phase 5: WS is the only gateway-to-pod data carrier.
POD_TRANSPORT=ws

# APNs (§11) — optional until push is enabled
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID=com.pipod.app

# Deployment-wide limits: pods a user may have awake at the provider at once, and per-pod
# resource ceilings. The concurrency cap applies to launches and to waking a stopped pod; a
# sleeping pod holds no slot. An org policy maxConcurrentPods can only narrow it, never raise it.
# POD_MAX_CONCURRENT_PER_USER=25
# Raising a per-pod ceiling also needs the matching PI_POD_SANDBOX_MAX_* on every sandbox host;
# a host refuses a larger shape rather than shrinking it.
# POD_MAX_CPU=2
# POD_MAX_MEMORY_GB=4
# POD_MAX_DISK_GB=20

# Workspace seeding (PUT /v1/pods/:id/workspace/archive, POST /v1/pods/:id/workspace/clone):
# the compressed archive the server will spool per request, what the in-pod extractor may
# materialize (bytes and members), the wall-clock budget of one clone or extraction, and how
# long a launch flagged `workspaceSeed` holds Pi back before giving up on the client's seed.
# WORKSPACE_ARCHIVE_MAX_COMPRESSED_BYTES=268435456
# WORKSPACE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648
# WORKSPACE_ARCHIVE_MAX_ENTRIES=200000
# WORKSPACE_SEED_TIMEOUT_SECONDS=600
# WORKSPACE_SEED_GATE_TIMEOUT_SECONDS=600

# EVENT_RETENTION_DAYS=90
# EVENT_MAX_ROWS=4000000
