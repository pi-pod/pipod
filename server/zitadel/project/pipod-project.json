{
  "note": "Desired-state contract for the `pipod` Zitadel project. The reconciler (scripts/reconcile-zitadel.mjs) enforces this non-destructively; tests fail on drift between this file and the runtime permission list. Client ids are generated by Zitadel and therefore not part of this contract; the API audience is the generated project id. An app's `serverPaths` are pages the server itself serves; the reconciler registers them on loopback and on PIPOD_SERVER_URL.",
  "project": {
    "name": "pipod",
    "projectRoleAssertion": true,
    "projectRoleCheck": false,
    "hasProjectCheck": false
  },
  "roles": [
    { "key": "pods:launch", "group": "permission" },
    { "key": "pods:manage_any", "group": "permission" },
    { "key": "templates:write", "group": "permission" },
    { "key": "jobs:write", "group": "permission" },
    { "key": "secrets:org:write", "group": "permission" },
    { "key": "secrets:own:write", "group": "permission" },
    { "key": "settings:own:write", "group": "permission" },
    { "key": "policy:write", "group": "permission" },
    { "key": "org:manage", "group": "permission" },
    { "key": "audit:read", "group": "permission" },
    { "key": "member", "group": "bundle" },
    { "key": "admin", "group": "bundle" },
    { "key": "owner", "group": "bundle" }
  ],
  "apps": [
    {
