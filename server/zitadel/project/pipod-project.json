        "http://127.0.0.1:43119/callback",
        "http://127.0.0.1:43120/callback",
        "http://127.0.0.1:43121/callback",
        "http://127.0.0.1:43122/callback",
        "http://127.0.0.1:43123/callback",
        "http://127.0.0.1:43124/callback",
        "http://127.0.0.1:43125/callback",
        "http://127.0.0.1:43126/callback"
      ],
      "accessTokenType": "OIDC_TOKEN_TYPE_JWT",
      "accessTokenRoleAssertion": true,
      "idTokenRoleAssertion": true,
      "idTokenUserinfoAssertion": true,
      "devMode": false
