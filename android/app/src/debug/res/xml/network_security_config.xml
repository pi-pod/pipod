<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay. Cleartext stays off by default and is permitted for the
     three hosts a local dev server can appear on: 10.0.2.2 is the emulator's alias
     for the host loopback, and localhost/127.0.0.1 cover an adb reverse forward. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
