# Copy to .env and fill in. This file holds every secret of the deployment:
#   chmod 600 .env
# Back up ZITADEL_MASTERKEY and SECRETS_KEK offline, separately from the database dumps in
# ./backups — a dump is unusable without them, and useless to a thief who lacks them.

# Database password. Hex keeps it safe inside the connection URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Seals Zitadel's own keys in Postgres. EXACTLY 32 characters:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
ZITADEL_MASTERKEY=
# First-boot Console admin; Zitadel forces a change on first sign-in. Needs upper and lower
# case, a number and a symbol, or Zitadel's first boot aborts:
#   echo "$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 20)aA1!"
ZITADEL_ADMIN_PASSWORD=

# Envelope key for stored secrets. Base64 of 32 random bytes:
#   openssl rand -base64 32
SECRETS_KEK=
SECRETS_KEK_ID=kek-1

# Shared by the server and the sandbox:
#   openssl rand -hex 32
PI_POD_SANDBOX_TOKEN=

# Where pods dial the server back, from inside a sandbox — this host's own address, never
# 127.0.0.1 (inside a pod that is the pod itself).
PUBLIC_URL=http://<this host>:8080

# The pi pod project id that reconcile-zitadel.mjs prints (guide, step 3). Until it is set,
# every real Zitadel token is rejected.
ZITADEL_API_AUDIENCE=

# --- Optional -----------------------------------------------------------------------------

# Going public (guide, "Going public"): set all five together.
# ZITADEL_ISSUER=https://auth.example.com
# ZITADEL_EXTERNALDOMAIN=auth.example.com
# ZITADEL_EXTERNALPORT=443
# ZITADEL_EXTERNALSECURE=true
# ZITADEL_TLS_MODE=external
# Comma-separated browser origins, only if you serve the web app.
# WEB_ORIGINS=https://app.example.com

# Sandbox sizing; the defaults fit an 8 GB / 4 vCPU host (guide, "Sizing").
# PI_POD_SANDBOX_FLEET_MEMORY_GB=4
# PI_POD_SANDBOX_FLEET_CPU=3
# PI_POD_SANDBOX_RESERVE_MEMORY_GB=3
# PI_POD_SANDBOX_RESERVE_CPU=0.5
# Largest pod anyone may launch. The server and the sandbox both read these.
# POD_MAX_CPU=2
# POD_MAX_MEMORY_GB=4
# POD_MAX_DISK_GB=20

# Dumps kept in ./backups (one per `docker compose up`).
# PIPOD_BACKUP_KEEP=7

# Retired secret keys during a rotation: {"kek-1":"<base64>"}
# SECRETS_KEK_PREVIOUS=
# Bearer token for GET /metrics (16+ characters); unset leaves it open on the private network.
# METRICS_TOKEN=

# Reuse the volumes of an install from the earlier hand-built guide (guide, "Moving from the
# hand-built layout"): `server` for this repository's server/ directory, `pi-pod-server` for
# the former pi-pod-server checkout.
# COMPOSE_PROJECT_NAME=server
