# selfhost/upgrade writes .env from this file on the first install, with every secret below
# generated, so there is nothing to fill in. It holds every secret of the deployment; keep it
# at mode 600. Back up ZITADEL_MASTERKEY and SECRETS_KEK offline, separately from the database
# dumps in ./backups — a dump is unusable without them, and useless to a thief who lacks them.

# Database password (hex keeps it safe inside the connection URL).
POSTGRES_PASSWORD=
# Seals Zitadel's own keys in Postgres. Exactly 32 characters.
ZITADEL_MASTERKEY=
# First-boot admin of the Zitadel Console (user `admin`), for settings such as SMTP.
ZITADEL_ADMIN_PASSWORD=
# Envelope key for stored secrets: base64 of 32 random bytes.
SECRETS_KEK=
SECRETS_KEK_ID=kek-1
# Shared by the server and the sandbox.
PI_POD_SANDBOX_TOKEN=

# Written by selfhost/upgrade once it has created the pipod project in Zitadel.
ZITADEL_API_AUDIENCE=
ZITADEL_CLI_CLIENT_ID=

# --- Optional -----------------------------------------------------------------------------

# Going public (guide, "Going public"): set all five together.
# ZITADEL_ISSUER=https://auth.example.com
# ZITADEL_EXTERNALDOMAIN=auth.example.com
# ZITADEL_EXTERNALPORT=443
# ZITADEL_EXTERNALSECURE=true
# ZITADEL_TLS_MODE=external
# Comma-separated browser origins, only if you serve the web app.
# WEB_ORIGINS=https://app.example.com

# Where pods dial the server. The default is the server's own address inside this deployment;
# set it only when the sandbox runs somewhere that cannot reach that.
# PUBLIC_URL=http://10.79.0.10:8080
# Pods reach no private address (LAN, VPC, tailnet, this host) except the server above. List
# any other they need, comma-separated: a PUBLIC_URL on a private address, a private git host.
# PI_POD_SANDBOX_PRIVATE_EGRESS=192.168.1.20,10.0.5.0/24

# Sandbox sizing (guide, "Sizing"): pods may use this host's memory and CPU less a reserve kept
# for Postgres, Zitadel and the server. On a 4 GB host, lower the reserve to 1.5.
# PI_POD_SANDBOX_RESERVE_MEMORY_GB=3
# PI_POD_SANDBOX_RESERVE_CPU=0.5
# A fixed ceiling instead of `auto` (host total less the reserve):
# PI_POD_SANDBOX_FLEET_MEMORY_GB=auto
# PI_POD_SANDBOX_FLEET_CPU=auto
# Largest pod anyone may launch. The server and the sandbox both read these.
# POD_MAX_CPU=2
# POD_MAX_MEMORY_GB=4
# POD_MAX_DISK_GB=20

# Dumps kept in ./backups (one per `docker compose up`).
# PIPOD_BACKUP_KEEP=7

# Retired secret keys during a rotation: {"kek-1":"<base64>"}
# SECRETS_KEK_PREVIOUS=
# Bearer token for GET /metrics (16+ characters), generated on install. Unset leaves /metrics
# open to anyone who can reach port 8080.
# METRICS_TOKEN=

# Only for an instance whose Zitadel was set up by hand: the personal access token of an
# IAM_OWNER service user, so selfhost/add-user and selfhost/upgrade can manage Zitadel.
# ZITADEL_PAT=

# Reuse the volumes of an install from the earlier hand-built guide (guide, "Moving from the
# hand-built layout"): `server` for this repository's server/ directory, `pi-pod-server` for
# the former pi-pod-server checkout.
# COMPOSE_PROJECT_NAME=server
