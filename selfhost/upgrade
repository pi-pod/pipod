#!/usr/bin/env bash
# Install or upgrade this deployment to the checked-out commit:
#
#   git pull && selfhost/upgrade
#
# The first run writes .env with new secrets. Every run builds the server and sandbox images
# from the checkout, publishes the pod base image the new server launches from to the bundled
# registry, then `docker compose up -d`: Compose dumps the database first, and the server
# migrates itself and opens launch admission before it serves. Zitadel's pipod project is
# created on the first run and checked for drift on every later one;
# `selfhost/upgrade --apply-zitadel` applies this release's version of it.
set -euo pipefail
cd "$(dirname "$0")"

apply_zitadel=false
case "${1:-}" in
  "") ;;
  --apply-zitadel) apply_zitadel=true ;;
  *) echo "usage: selfhost/upgrade [--apply-zitadel]" >&2; exit 2 ;;
esac

# shellcheck source=lib.sh
. ./lib.sh

wait_healthy() {
  for _ in $(seq 1 120); do
    if [ "$(compose ps "$1" --format '{{.Health}}')" = healthy ]; then return 0; fi
    sleep 2
  done
  compose logs --tail 20 "$1" >&2
  echo "upgrade: $1 did not become healthy; its log is above" >&2
  exit 1
}

first_install=false
if [ ! -e .env ]; then
  if docker volume inspect pipod_pgdata >/dev/null 2>&1; then
    echo "upgrade: this host already has a pi pod database but no selfhost/.env; restore .env from your backup (new secrets cannot open that data)" >&2
    exit 1
  fi
  first_install=true
  (umask 077 && cp .env.example .env)
  env_set POSTGRES_PASSWORD "$(openssl rand -hex 24)"
  env_set ZITADEL_MASTERKEY "$(openssl rand -hex 16)"
  env_set ZITADEL_ADMIN_PASSWORD "$(openssl rand -hex 12)aA1!"
  env_set SECRETS_KEK "$(openssl rand -base64 32)"
  env_set PI_POD_SANDBOX_TOKEN "$(openssl rand -hex 32)"
  echo "upgrade: wrote selfhost/.env with new secrets; back up ZITADEL_MASTERKEY and SECRETS_KEK offline"
fi

# The server records this commit when it opens launch admission after a migration held it.
PIPOD_SOURCE_SHA="$(git rev-parse HEAD)"
export PIPOD_SOURCE_SHA

compose build server sandbox

# The registry lives in the sandbox's network namespace, so it is reachable once the sandbox is.
compose up -d sandbox registry
for _ in $(seq 1 60); do
  if compose exec -T sandbox curl -fsS http://127.0.0.1:8433/v1/healthz >/dev/null 2>&1; then break; fi
  sleep 2
done

# The base image tag digests the pi version, the launcher and the image assets, so only the new
# server knows it. Rebuilding an unchanged tag is a cache hit and the push a no-op.
read -r base pi < <(docker run --rm pipod/server:local node dist/base-image.js </dev/null)
target="127.0.0.1:5000/pipod/$base"
context="$(mktemp -d)"
trap 'rm -rf "$context"' EXIT
cp ../server/image/Dockerfile "$context/"
: > "$context/pi-packages.txt"
: > "$context/pi-packages-npm.txt"
: > "$context/bake.sh"
docker build --build-arg "PI_VERSION=$pi" -t "$target" "$context"
docker push "$target"

compose up -d

# Zitadel's pipod project: created on the first run, then only checked unless --apply-zitadel.
# The server needs its id
# as the token audience, and publishes the CLI's and the phone apps' client ids to sign-in.
wait_healthy zitadel
mode=--check
if [ -z "$(env_get ZITADEL_API_AUDIENCE)" ] || $apply_zitadel; then mode=--apply; fi
status=0
report="$(admin zitadel/scripts/reconcile-zitadel.mjs "$mode" 2>&1)" || status=$?
if [ "$status" = 0 ]; then
  audience="$(sed -n 's/^project id (API audience): //p' <<<"$report")"
  client="$(sed -n 's/^client id pipod-cli: //p' <<<"$report")"
  mobile="$(sed -n 's/^client id pipod-mobile: //p' <<<"$report")"
  if [ -z "$audience" ] || [ -z "$client" ] || [ -z "$mobile" ]; then
    echo "$report" >&2
    echo "upgrade: Zitadel did not report the pipod project's ids" >&2
    exit 1
  fi
  if [ "$audience" != "$(env_get ZITADEL_API_AUDIENCE)" ] || [ "$client" != "$(env_get ZITADEL_CLI_CLIENT_ID)" ] ||
    [ "$mobile" != "$(env_get ZITADEL_MOBILE_CLIENT_ID)" ]; then
    env_set ZITADEL_API_AUDIENCE "$audience"
    env_set ZITADEL_CLI_CLIENT_ID "$client"
    env_set ZITADEL_MOBILE_CLIENT_ID "$mobile"
    compose up -d server
  fi
elif [ "$status" = 2 ]; then
  # Drift: this release changed the project (a new redirect, say), or someone changed it in
  # the Console. Applying is not automatic because it also resets Console changes.
  echo "$report" >&2
  echo "upgrade: warning: Zitadel's pipod project differs from this release (above). Apply this" >&2
  echo "upgrade: release's version with: selfhost/upgrade --apply-zitadel" >&2
  echo "upgrade: (it also resets changes made in the Zitadel Console, such as a pipod-web redirect)" >&2
elif [ "$mode" = --apply ]; then
  echo "$report" >&2
  echo "upgrade: could not apply the pipod project to Zitadel; the error is above" >&2
  exit 1
else
  echo "$report" >&2
  echo "upgrade: warning: Zitadel's pipod project was not checked; the reason is above" >&2
fi

# The server migrates before it serves, so healthy means upgraded.
wait_healthy server
echo "upgrade: server healthy at $PIPOD_SOURCE_SHA"
if [ "$first_install" = true ]; then
  cat <<'EOF'

pi pod is running. Give yourself an account, then sign in from this machine:

  selfhost/add-user you@example.com --owner
  pipod login --server http://127.0.0.1:8080
EOF
fi
