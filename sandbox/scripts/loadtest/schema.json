{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pi-pod-sandbox load-test result envelope",
  "description": "Unified result JSON every scripts/loadtest/lt.mjs subcommand writes (result-<subcommand>-<ts>.json).",
  "type": "object",
  "required": [
    "schemaVersion",
    "host",
    "class",
    "imageDigest",
    "kernel",
    "config",
    "subcommand",
    "n",
    "p50",
    "p90",
    "p95",
    "p99",
    "max",
    "wallMs",
    "errors",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "host": { "type": "string", "minLength": 1 },
    "class": { "type": "string", "minLength": 1 },
    "imageDigest": { "type": "string", "minLength": 1 },
    "kernel": { "type": "string", "minLength": 1 },
    "config": { "type": "object" },
    "subcommand": { "type": "string", "minLength": 1 },
    "n": { "type": "integer", "minimum": 0 },
    "p50": { "type": ["number", "null"], "minimum": 0 },
    "p90": { "type": ["number", "null"], "minimum": 0 },
    "p95": { "type": ["number", "null"], "minimum": 0 },
    "p99": { "type": ["number", "null"], "minimum": 0 },
    "max": { "type": ["number", "null"], "minimum": 0 },
    "wallMs": { "type": ["number", "null"], "minimum": 0 },
    "errors": { "type": "array", "items": { "type": "string" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  }
}
