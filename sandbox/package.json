{
  "name": "pi-pod-sandbox",
  "version": "0.1.0",
  "description": "Self-hosted sandbox service: one container hosting N isolated sandboxes for pi pod",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "pi-pod-sandbox": "dist/main.js",
    "pi-pod-sandbox-observations": "dist/scripts/service-observations.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "package:native": "bash scripts/package-native.sh",
    "typecheck": "tsc --noEmit",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:root": "node --import tsx --test \"test/root/**/*.test.ts\"",
    "loadtest": "node scripts/loadtest/lt.mjs",
    "check": "npm run typecheck"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "node-pty": true
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "node-pty": "^1.1.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
